func _ready() -> void:
	var cfg := ConfigFile.new()
	if cfg.load("user://settings.cfg") == OK:
		lang = str(cfg.get_value("ui", "language", "ru"))
	if lang != "en":
		lang = "ru"


func t(key: String) -> String:
	var table: Dictionary = EN if lang == "en" else RU
	return str(table.get(key, key))


func tf(key: String, args: Array) -> String:
	var s := t(key)
	return s % args


func tc(item: Dictionary) -> String:
	if lang == "en":
		return str(item.get("name_en", item.get("name", item.get("id", "?"))))
	return str(item.get("name", item.get("id", "?")))


func dc(item: Dictionary) -> String:
	if lang == "en":
		return str(item.get("desc_en", item.get("desc", "")))
	return str(item.get("desc", ""))


func season_name(season: int) -> String:
	var keys := ["spring", "summer", "autumn", "winter"]
	return t(keys[clampi(season, 0, 3)])


func stage_name(stage: String) -> String:
	return t("stage_" + stage)


func role_name(role: String) -> String:
	return t("role_" + role)


func num(n: float) -> String:
	var v := int(round(n))
	var s := str(abs(v))
	var out := ""
	var c := 0
	for i in range(s.length() - 1, -1, -1):
		out = s[i] + out
		c += 1
		if c % 3 == 0 and i > 0:
			out = (" " if lang != "en" else ",") + out
	return ("-" if v < 0 else "") + out


func compact(n: float) -> String:
	if abs(n) >= 1000000:
		return ("%.1f" % (n / 1000000.0)).trim_suffix(".0") + " " + t("million")
	if abs(n) >= 10000:
		return ("%.1f" % (n / 1000.0)).trim_suffix(".0") + " " + t("thousand")
	return num(n)


func set_lang(l: String) -> void:
	lang = "en" if l == "en" else "ru"
	var cfg := ConfigFile.new()
	cfg.load("user://settings.cfg")
	cfg.set_value("ui", "language", lang)
	cfg.save("user://settings.cfg")
