# ============================================================================
# Aetheria — .gitignore
# ВАЖНО: сюда не должны попадать секреты, локальные данные и посторонние
# инструменты. Готовые сборки из build/ НЕ игнорируются — они входят в проект.
# ============================================================================

# --- секреты и учётные данные (критично) ------------------------------------
docs/GITHUB_DATA.md
**/GITHUB_DATA.md
.env
.env.*
*.token
*.tokens
*.secret
*.secrets
credentials*
secrets*
*credentials*.json
*secret*.json
**/*token*
**/*secret*
**/*credential*
**/*GITHUB_DATA*
.netrc
.git-credentials
cookies.txt
cookies*.txt
*.cookie
*.cookies
*.pem
*.key
*.crt
*.cer
*.p12
*.pfx
*.jks
*.keystore
id_rsa*
id_dsa*
id_ecdsa*
id_ed25519*
.ssh/
.aws/
.gcloud/
.azure/
.npmrc
.pypirc
*.kdbx
*.ovpn
*.rdp
*.mobileconfig

# --- сторонние исполняемые файлы (кроме готовой сборки) --------------------
*.exe
!build/Aetheria.exe
*.msi
*.msix
*.appx
*.dmg
*.pkg
*.deb
*.rpm
*.appimage

# --- пользовательские данные игры -------------------------------------------
saves/
save/
*.sav
*.save
*.sav.gz
user_data/
userdata/
settings.cfg
export_credentials.cfg
*.translation

# --- Godot ----------------------------------------------------------------
.godot/
**/.godot/
.import/
*.import.bak
*.tmp
*.temp
*.bak
*.orig
*.rej
*.swp
*.swo
*~
export.cfg
.import/
*.translation
crash-*.txt
objectdb_snapshots/
shader_cache/
vulkan/
*.pck.tmp
*.pck*.tmp

# --- ОС и IDE -------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini
Desktop.ini
$RECYCLE.BIN/
*.lnk
*.url
.vscode/
.idea/
.fleet/
*.code-workspace
*.suo
*.user
*.userosscache
*.sln.docstates
.vs/

# --- логи, дампы, кэш -----------------------------------------------------
*.log
log/
logs/
*.dmp
*.dump
*.stackdump
*.sqlite
*.sqlite3
*.db
*.db-wal
*.db-shm
.cache/
.caches/
coverage/
.coverage
htmlcov/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/

# --- Python (assetfinder, инструменты) ------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build_py/
dist/
*.egg-info/
.eggs/
.venv/
venv/
env/
ENV/
pip-wheel-metadata/

# --- Node / JS (не используется, но на случай инструментов) ----------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
package-lock.json.bak

# --- инструменты и сырые ассеты, не относящиеся к игре ---------------------
tools/godot/
tools/godot_templates/
tools/assetfinder/downloads/
tools/assetfinder/af/__pycache__/
tools/assetfinder/__pycache__/
_assets_raw/
*.tpz
*.tar.xz
*.7z
*.rar
*.zip

# --- моды (в репозитории только README) ------------------------------------
game/mods/*
!game/mods/README.md
mods/*
!mods/README.md

# --- локальные сборки и мусор сборки --------------------------------------
build/*.tmp
build/*.temp
build/*.log
build/*.pdb
build/*.ilk
build/*.exp
build/*.lib
build/*.zip
build/*.7z
build/*.rar

# --- скриншоты: оставляем витрину, но не временные файлы -------------------
shots/*.tmp
shots/*.bak

# --- прочее ---------------------------------------------------------------
*.part
*.crdownload
*.download
*.!ut
*.aria2
*.lock
.lock
*~
